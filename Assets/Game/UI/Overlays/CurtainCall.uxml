<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/Game/UI/Hud.uss?fileID=7433441132597879392&amp;guid=42b16e5b088da410783ee233311de3ad&amp;type=3#Hud" />
    <ui:VisualElement name="game-over" class="game-over">
        <ui:VisualElement class="curtain-call-panel">
            <ui:Label text="THE CIRCUSSY ONE" class="curtain-call-brand" />
            <ui:Label text="GAME OVER" class="game-over-title" />
            <ui:Label text="The run is over" class="game-over-subtitle" />
            <ui:VisualElement class="curtain-call-summary-grid">
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="TIME" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-time" text="00:00" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="ACT" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-act" text="ACT I" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="CAUSE" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-cause" text="Overwhelmed" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="KILLS" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-kills" text="0" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="LEVELS" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-level" text="Level 1 (+0)" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="TICKETS" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-tickets" text="0" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="WEAPONS" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-weapons" text="0" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat">
                    <ui:Label text="ITEMS" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-items" text="0" class="curtain-call-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="curtain-call-stat curtain-call-stat-wide">
                    <ui:Label text="DAMAGE DEALT" class="curtain-call-stat-label" />
                    <ui:Label name="curtain-call-damage" text="0" class="curtain-call-stat-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="restart-button" text="MAIN MENU" class="restart-button marquee-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
