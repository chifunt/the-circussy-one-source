    height: 20px;
    font-size: 14px;
    color: rgb(255, 213, 82);
    -unity-font-definition: url("../Fonts/Rye/Rye-Regular.ttf");
}

.upgrade-icon {
    width: 122px;
    height: 122px;
    min-width: 122px;
    min-height: 122px;
    max-width: 122px;
    max-height: 122px;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgb(245, 238, 224);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(255, 235, 112);
    border-right-color: rgb(255, 235, 112);
    border-top-color: rgb(255, 235, 112);
    border-bottom-color: rgb(255, 235, 112);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.upgrade-title {
    color: rgb(255, 239, 156);
    font-size: 20px;
    -unity-font-definition: url("../Fonts/Rye/Rye-Regular.ttf");
    -unity-text-outline-color: rgb(17, 8, 7);
    -unity-text-outline-width: 1px;
}

.upgrade-description,
.upgrade-preview,
.upgrade-level {
    color: rgb(231, 216, 177);
    font-size: 12px;
}

.upgrade-hint {
    color: rgb(242, 210, 140);
}

.upgrade-ray-layer,
.reward-reveal-ray-layer,
.ui-ray-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    display: none;
}

.upgrade-ray,
.ui-ray {
    position: absolute;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.upgrade-confetti-layer,
.ui-confetti-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    display: none;
}

.upgrade-confetti-piece,
.ui-confetti-piece {
    position: absolute;
    background-color: rgb(255, 235, 112);
}

.pause-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(1, 1, 1, 0.72);
}

.pause-menu-panel {
    width: 900px;
    max-height: 88%;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 20px;
    padding-bottom: 20px;
    align-items: stretch;
    background-color: rgb(12, 12, 10);
    border-left-width: 7px;
    border-right-width: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-color: rgb(218, 41, 34);
    border-right-color: rgb(218, 41, 34);
    border-top-color: rgb(218, 41, 34);
    border-bottom-color: rgb(218, 41, 34);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.pause-menu-title {
    height: 56px;
    color: rgb(255, 247, 188);
    font-size: 42px;
    -unity-font-definition: url("../Fonts/Budmo_Jiggler/Budmo-Jiggler.otf");
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(25, 13, 10);
    -unity-text-outline-width: 2px;
    -unity-text-align: middle-center;
}

.pause-menu-body {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    margin-top: 12px;
}

.pause-menu-side-panel {
    width: 250px;
    min-height: 330px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgb(18, 17, 14);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(218, 41, 34);
    border-right-color: rgb(218, 41, 34);
    border-top-color: rgb(218, 41, 34);
    border-bottom-color: rgb(218, 41, 34);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.pause-menu-actions {
    width: 260px;
    margin-left: 24px;
    margin-right: 24px;
    justify-content: center;
}

.pause-menu-button {
    width: 240px;
    height: 52px;
    min-height: 52px;
    margin-top: 7px;
    margin-bottom: 7px;
    font-size: 16px;
}

.pause-menu-debug-container {
    height: 260px;
    max-height: 260px;
    margin-top: 14px;
    padding-top: 8px;
    padding-left: 4px;
    padding-right: 4px;
    border-top-width: 2px;
    border-top-color: rgba(255, 224, 102, 0.6);
    overflow: hidden;
}

.pause-settings-host {
    display: none;
    margin-top: 14px;
    align-items: center;
}

.pause-settings-host .settings-panel {
    width: 520px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    align-items: center;
    background-color: rgb(18, 17, 14);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(218, 41, 34);
    border-right-color: rgb(218, 41, 34);
    border-top-color: rgb(218, 41, 34);
    border-bottom-color: rgb(218, 41, 34);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.pause-settings-host .settings-title {
    color: rgb(255, 247, 188);
    font-size: 30px;
    -unity-font-definition: url("../Fonts/Budmo_Jiggler/Budmo-Jiggler.otf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-settings-host .settings-heading,
.pause-settings-host .settings-copy {
    color: rgb(233, 217, 179);
    -unity-text-align: middle-center;
    white-space: normal;
}

.pause-settings-host .settings-back-button {
    width: 220px;
    height: 48px;
    min-height: 48px;
    margin-top: 14px;
}

.pause-menu-debug {
    padding-top: 4px;
    padding-bottom: 16px;
    align-items: center;
}

.pause-menu-debug-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 3px;
    margin-bottom: 3px;
}

.pause-menu-debug-button {
    width: 190px;
    height: 42px;
    min-height: 42px;
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 12px;
}

.pause-menu-debug-field {
    width: 84px;
    min-width: 84px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.pause-menu-debug-dropdown {
    width: 164px;
    min-width: 164px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.pause-menu-section-title {
    color: rgb(255, 235, 112);
    font-size: 16px;
    -unity-font-definition: url("../Fonts/Budmo_Jiggler/Budmo-Jiggler.otf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-menu-state,
.pause-menu-items-empty,
.pause-menu-status {
    color: rgb(233, 217, 179);
    white-space: normal;
    font-size: 13px;
    -unity-text-align: upper-left;
}

.pause-menu-status {
    height: 24px;
    margin-top: 12px;
    color: rgb(255, 224, 102);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
