/* Circus modal overhaul */
.marquee-button {
    position: relative;
    overflow: visible;
    height: 50px;
    min-height: 50px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(255, 244, 183);
    background-color: rgb(8, 8, 7);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(226, 43, 35);
    border-right-color: rgb(226, 43, 35);
    border-top-color: rgb(226, 43, 35);
    border-bottom-color: rgb(226, 43, 35);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-definition: url("../Fonts/Budmo_Jiggler/Budmo-Jiggler.otf");
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(27, 16, 9);
    -unity-text-outline-width: 1px;
    -unity-text-align: middle-center;
}

.marquee-button:hover,
.marquee-button:focus,
.marquee-button.is-focused,
.marquee-button.is-selected {
    border-left-color: rgb(255, 244, 134);
    border-right-color: rgb(255, 244, 134);
    border-top-color: rgb(255, 244, 134);
    border-bottom-color: rgb(255, 244, 134);
    background-color: rgb(17, 14, 10);
}

.marquee-effect-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 1;
}

.marquee-bulb-rail {
    position: absolute;
    justify-content: space-between;
    align-items: center;
}

.marquee-bulb-rail--top {
    left: 13px;
    right: 13px;
    top: 5px;
    height: 9px;
    flex-direction: row;
}

.marquee-bulb-rail--right {
    top: 13px;
    right: 5px;
    bottom: 13px;
    width: 9px;
    flex-direction: column;
}

.marquee-bulb-rail--bottom {
    left: 13px;
    right: 13px;
    bottom: 5px;
    height: 9px;
    flex-direction: row;
}

.marquee-bulb-rail--left {
    top: 13px;
    left: 5px;
    bottom: 13px;
    width: 9px;
    flex-direction: column;
}

.marquee-bulb {
    position: relative;
    width: 4px;
    height: 4px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgb(255, 236, 120);
}

.game-over {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin-left: 0;
    margin-top: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(1, 1, 1, 0.82);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

